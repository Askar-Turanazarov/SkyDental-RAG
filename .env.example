# ============================================================
# SkyDental RAG — переменные окружения.
# Скопируйте в .env и заполните. На Vercel те же переменные задаются
# в Project Settings → Environment Variables.
# ============================================================

# --- Фронтенд ---------------------------------------------------
# Куда ходит чат. /api/chat — свой бэкенд (локально Vite проксирует
# его на :8787, на Vercel это та же функция). Пусто — демо-режим
# прямо в браузере, без сервера.
VITE_RAG_ENDPOINT=/api/chat

# --- База данных ------------------------------------------------
# Neon: строка подключения из консоли Neon (pooled connection).
# Пусто — локально используется встроенный PGlite в папке .data/.
DATABASE_URL=

# --- Ключи провайдеров (нужны только те, что используются) -------
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Локальный Ollama: http://localhost:11434/v1
OLLAMA_BASE_URL=

# --- Модели -----------------------------------------------------
# Цепочка ответа: provider:model через запятую, в порядке приоритета.
# При 429/5xx/таймауте запрос уходит следующей модели.
LLM_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash
# Reasoning у Gemini 3: minimal | low | off
GEMINI_THINKING_LEVEL=minimal

# Эмбеддинги. После смены модели: npm run seed -- --force или
# «Переиндексировать всё» в админке.
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001

# Полностью офлайн, без ключей (для разработки и CI):
# LLM_CHAIN=local:extractive
# EMBED_PROVIDER=local
# EMBED_MODEL=hash-768
# RAG_MIN_SCORE=0.15

# --- RAG --------------------------------------------------------
# Сколько кусков идёт в промпт и порог близости для отказа.
RAG_TOP_K=5
RAG_MIN_SCORE=0.6

# --- Админка ----------------------------------------------------
ADMIN_PASSWORD=
# Случайная строка для подписи cookie: openssl rand -hex 32
ADMIN_SECRET=

# --- Защита ------------------------------------------------------
IP_SALT=change-me
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=600

# --- Локальный API ---------------------------------------------
# Vite проксирует /api на :8787 (vite.config.ts).
API_PORT=8787
